<Window x:Class="DevClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevClean.Models"
        Title="DevClean · 开发者磁盘清理器"
        Width="1200"
        Height="840"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="26,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1220" Offset="0" />
                    <GradientStop Color="#1E1B4B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="DC"
                                   Foreground="#FFFFFF"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DevClean"
                                       Foreground="#FFFFFF"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <Border Background="#26FFFFFF"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    Margin="9,4,0,0">
                                <TextBlock Text="v1.0.1"
                                           Foreground="#C7D2FE"
                                           FontSize="10" />
                            </Border>
                            <Border Background="#26F59E0B"
                                    CornerRadius="9"
                                    Padding="7,1"
                                    Margin="6,4,0,0"
                                    Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DEMO"
                                           Foreground="#FCD34D"
                                           FontSize="9.5"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="面向开发者的 C 盘清理工具 · 只清缓存，不碰代码"
                                   Foreground="#A5B4FC"
                                   FontSize="11.5"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding DriveName}"
                                       Foreground="#94A3B8"
                                       FontSize="11.5"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="  可用 "
                                       Foreground="#94A3B8"
                                       FontSize="11.5"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DriveFreeText}"
                                       Foreground="#FFFFFF"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar Width="176"
                                     Style="{StaticResource ThinProgressBar}"
                                     Value="{Binding DriveUsedPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Margin="0,6,0,4"
                                     HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DriveDetailText}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <Border Background="#1F34D399"
                            BorderBrush="#3334D399"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9,5"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="管理员模式"
                                   Foreground="#6EE7B7"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button Content="帮助" Style="{StaticResource HeaderButton}"
                            Click="HelpButton_Click" Margin="0,0,8,0" />

                    <Button Style="{StaticResource HeaderButton}"
                            Command="{Binding ScanCommand}"
                            Margin="12,0,0,0"
                            ToolTip="重新扫描所有清理项">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="刷新扫描"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Background="#EEF2FF"
                        BorderBrush="#C7D2FE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowDemoBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="演示模式 · 以下为示例数据，不会读取或删除任何本机文件。"
                                   FontSize="12"
                                   Foreground="#3730A3" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource AmberSoft}"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{StaticResource Amber}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="部分系统缓存需要管理员权限。普通开发缓存不受影响，可直接清理。"
                                   FontSize="12"
                                   Foreground="#92400E" />
                        <Button Grid.Column="2"
                                Content="以管理员身份重启"
                                Style="{StaticResource SmallWarnButton}"
                                Command="{Binding ElevateCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="发现可清理"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SubText}" />
                        <TextBlock Text="{Binding TotalReclaimableText}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding TotalReclaimableSubText}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="已选择"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SubText}" />
                        <TextBlock Text="{Binding SelectedText}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="建议项已自动勾选，可手动调整"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="系统盘可用"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SubText}" />
                        <TextBlock Text="{Binding DriveFreeText}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DriveDetailText}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="清理清单"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" />
                            <Border Background="#F2F4F9"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="白名单目录"
                                           FontSize="10"
                                           Foreground="{StaticResource SubText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Width="90"
                                             Style="{StaticResource ThinProgressBar}"
                                             Value="{Binding ScanProgress, Mode=OneWay}"
                                             Maximum="100"
                                             VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScanText}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource Muted}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <CheckBox Content="仅显示检测到的项"
                                      Style="{StaticResource AppCheckBox}"
                                      IsChecked="{Binding ShowOnlyAvailable, Mode=TwoWay}"
                                      FontSize="12"
                                      Foreground="{StaticResource SubText}"
                                      Margin="0,0,6,0" />

                            <Border Width="1" Height="18" Background="{StaticResource Line}" Margin="8,0" />

                            <Button Content="勾选建议项"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding SelectSafeCommand}" />
                            <Button Content="清空"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearSelectionCommand}"
                                    Margin="2,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="ItemList"
                             Grid.Row="1"
                             ItemsSource="{Binding ItemsView}"
                             ItemContainerStyle="{StaticResource CleanRowItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             MouseDoubleClick="OnListDoubleClick">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,14,12,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#64748B" />
                                            <Border Grid.Column="1"
                                                    Height="1"
                                                    Background="{StaticResource Line}"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CleanItem}">
                                <Grid Background="Transparent">
                                    <Grid.ToolTip>
                                        <ToolTip MaxWidth="560" Padding="13">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}" />
                                                <TextBlock Text="{Binding Note}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SubText}"
                                                           Margin="0,6,0,0" />
                                                <TextBlock Text="路径"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource Muted}"
                                                           Margin="0,10,0,2" />
                                                <TextBlock Text="{Binding PathText}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource SubText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="双击可在资源管理器中打开"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource Muted}"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource AppCheckBox}"
                                              IsChecked="{Binding Selected, Mode=OneWay}"
                                              Click="OnItemCheckBoxClick"
                                              IsEnabled="{Binding CanSelect}" />

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#EEF2FF"
                                                    CornerRadius="6"
                                                    Padding="6,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="管理员"
                                                           FontSize="9.5"
                                                           Foreground="#4F46E5" />
                                            </Border>
                                            <Border Background="{StaticResource AmberSoft}"
                                                    CornerRadius="6"
                                                    Padding="6,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="命令"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource Amber}" />
                                            </Border>
                                            <Border Background="#F1F5F9"
                                                    CornerRadius="6"
                                                    Padding="6,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsReportOnly, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="仅统计"
                                                           FontSize="9.5"
                                                           Foreground="#64748B" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource SubText}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11.5"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#047857" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                                                            <Setter Property="Foreground" Value="#4F46E5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeText}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12.5"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#0F172A" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Available}" Value="False">
                                                        <Setter Property="Foreground" Value="#A0A8B5" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Grid.Column="3"
                                            CornerRadius="9"
                                            Padding="7,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Risk}" Value="Caution">
                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Risk}" Value="Danger">
                                                        <Setter Property="Background" Value="#FEF2F2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RiskText}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#047857" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Risk}" Value="Caution">
                                                            <Setter Property="Foreground" Value="#B45309" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Risk}" Value="Danger">
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Button Grid.Column="4"
                                            Style="{StaticResource RowIconButton}"
                                            ToolTip="打开所在位置"
                                            Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE8DA;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0"
                            Padding="18,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="640"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding SafetyNote}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource Muted}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSummary}"
                                           FontSize="12"
                                           Foreground="{StaticResource SubText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <Button Content="清理选中"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CleanCommand}"
                                        MinWidth="112" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
