<Window x:Class="DevClean.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清理"
        Width="620"
        Height="580"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PageBg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="12" Background="#EEF2FF">
                <TextBlock Text="&#xE74D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{StaticResource Accent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="确认清理"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" />
                <TextBlock Text="请确认下面的项目和风险提示"
                           FontSize="11.5"
                           Foreground="{StaticResource SubText}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,10">
            <TextBlock x:Name="SummaryText"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" />
            <TextBlock Text="删除操作不可撤销，被占用的文件会自动跳过。"
                       FontSize="11"
                       Foreground="{StaticResource Muted}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8,6">
            <ListBox x:Name="ItemList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border Background="Transparent" Padding="8,7">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SizeText}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12"
                                       Foreground="{StaticResource Ink}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding RiskText}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       MinWidth="34">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="#047857" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="Caution">
                                                <Setter Property="Foreground" Value="#B45309" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="Danger">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <CheckBox x:Name="DangerCheck"
                  Grid.Row="3"
                  Style="{StaticResource AppCheckBox}"
                  Content="我已知晓高风险项可能影响系统功能，且无法恢复"
                  Foreground="#B91C1C"
                  FontSize="12"
                  Margin="2,12,0,0"
                  Visibility="Collapsed"
                  Checked="OnDangerCheckChanged"
                  Unchecked="OnDangerCheckChanged" />

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="清理记录会写入 %LOCALAPPDATA%\DevClean\logs"
                       FontSize="10"
                       Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="88"
                        Height="36" />
                <Button x:Name="ConfirmButton"
                        Content="开始清理"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="104"
                        Height="36"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
